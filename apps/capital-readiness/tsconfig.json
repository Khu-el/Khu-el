{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The test files import ../src/finance.ts by its real extension, which is
    // how `node --test` resolves them with type stripping and no bundler.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@nte/governance-core": ["../../packages/governance-core/src/index.ts"]
    }
  },
  "include": ["src", "test", "../../packages/governance-core/src"]
}
