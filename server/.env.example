# Copy this file to .env (or otherwise set these as real environment
# variables) before deploying anywhere beyond your own machine.

# Required for any real deployment. Without this, the server generates and
# persists a random secret to data/.jwt-secret on first boot -- fine for
# local dev, not fine for anything shared/production.
JWT_SECRET=

# Required to let anyone register at all -- registration is fail-closed.
# Without this set, the server generates one on first boot and prints the
# actual value to the logs (`fly logs`) so you can retrieve and share it.
# Set your own to control it, and change it any time to cut off new
# registrations without affecting anyone already registered.
INVITE_CODE=

# Optional, and fail-closed when unset. The single email address that becomes
# SYSTEM_ADMIN when it registers -- an admin can read and delete every user's
# records in every app, across both lanes. It is set here, on the platform,
# rather than chosen at registration, because INVITE_CODE is meant to be shared
# and must not confer authority over anyone else's records. Leave blank and no
# registration can ever produce an admin.
BOOTSTRAP_ADMIN_EMAIL=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the four apps' local dev ports if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Optional. Without these, "Email me this" / digest emails return a clear
# "SMTP is not configured" response instead of silently failing. This app
# can only ever email the signed-in user's own account address -- there is
# no way to configure a different recipient.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional overrides for where SQLite data and uploaded files live.
# NTE_DATA_DIR=./data
# NTE_UPLOADS_DIR=./uploads

PORT=4000
