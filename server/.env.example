# Copy this file to .env (or otherwise set these as real environment
# variables) before deploying anywhere beyond your own machine.

# Required in production: boot throws if this is missing. Locally, the server
# generates a secret at data/.jwt-secret and does not print it.
JWT_SECRET=

# Required in production: boot throws if this is missing. Locally, the server
# generates one at data/.invite-code and does not print the value. Set your
# own to control it. Change it to cut off new registrations without affecting
# anyone already registered.
INVITE_CODE=

# Optional, and fail-closed when unset. The single email address that can
# register as SYSTEM_ADMIN. An admin can read and delete every user's records
# in every app, across both lanes. The address is set on the platform, not
# chosen at registration. Leave blank and no registration can produce an admin.
BOOTSTRAP_ADMIN_EMAIL=

# Required together with BOOTSTRAP_ADMIN_EMAIL. The shared invite code cannot
# create SYSTEM_ADMIN. Missing or wrong returns 403 and inserts nothing. A
# second admin returns 409. Unset fails closed. Do not commit a real value.
BOOTSTRAP_ADMIN_SECRET=

# Optional, and fail-closed when unset. Comma-separated addresses that
# register as NTE_SYSTEMS_OPERATOR (ministry operator). A role field on
# registration or PATCH /api/auth/me cannot assign this or SYSTEM_ADMIN.
# This role does not read other accounts' records.
MINISTRY_OPERATOR_EMAILS=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the four apps' local dev ports if unset.
# Include both localhost and 127.0.0.1. They are different browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179

# Optional. Without these, "Email me this" / digest emails return a clear
# "SMTP is not configured" response instead of silently failing. This app
# can only ever email the signed-in user's own account address -- there is
# no way to configure a different recipient.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional overrides for where SQLite data and uploaded files live.
# NTE_DATA_DIR=./data
# NTE_UPLOADS_DIR=./uploads

PORT=4000
