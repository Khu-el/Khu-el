# Copy this file to .env (or otherwise set these as real environment
# variables) before deploying anywhere beyond your own machine.

# Required for any real deployment. Without this, the server generates and
# persists a random secret to data/.jwt-secret on first boot -- fine for
# local dev, not fine for anything shared/production.
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the four apps' local dev ports if unset.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Optional. Without these, "Email me this" / digest emails return a clear
# "SMTP is not configured" response instead of silently failing. This app
# can only ever email the signed-in user's own account address -- there is
# no way to configure a different recipient.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional overrides for where SQLite data and uploaded files live.
# NTE_DATA_DIR=./data
# NTE_UPLOADS_DIR=./uploads

PORT=4000
