{
  "name": "nte-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:lanes && npm run check:network && tsc -b && vite build && npm run check:bundle",
    "preview": "vite preview",
    "check:types": "tsc -b --noEmit",
    "check:lanes": "node scripts/check-lanes.mjs",
    "check:network": "node scripts/check-network.mjs",
    "test": "vitest run",
    "check": "npm run check:types && npm run check:lanes && npm run check:network && npm test && npm run build",
    "predev": "npm run check:network",
    "pretest": "npm run check:network",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
