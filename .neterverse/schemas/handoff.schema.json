{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neterverse://schemas/handoff.schema.json",
  "title": "Universal AI handoff packet",
  "description": "The machine-readable packet one runtime leaves for its peer. Carries conclusions, evidence and state - never hidden reasoning.",
  "type": "object",
  "required": [
    "handoff_id", "timestamp", "sender", "recipient", "lane", "entity", "capacity",
    "risk_tier", "objective", "current_state", "required_output", "last_action", "next_action", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "handoff_id": { "type": "string", "pattern": "^ho_[a-z0-9_]+$" },
    "correlation_id": { "type": "string" },
    "project_id": { "type": "string" },
    "task_id": { "type": "string" },
    "parent_task_id": { "type": ["string", "null"] },
    "sender": { "type": "string", "enum": ["CLAUDE_CODE", "CODEX", "OTHER_AUTHORIZED_RUNTIME", "HUMAN"] },
    "recipient": { "type": "string", "enum": ["CLAUDE_CODE", "CODEX", "OTHER_AUTHORIZED_RUNTIME", "HUMAN"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "lane": { "type": "string", "enum": ["LANE_A", "LANE_B", "PERSONAL", "PHILANTHROPIC", "UNCLASSIFIED"] },
    "entity": { "type": "string", "minLength": 1 },
    "capacity": { "type": "string", "minLength": 1 },
    "risk_tier": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "objective": { "type": "string", "minLength": 1 },
    "current_state": { "type": "string", "minLength": 1 },
    "verified_facts": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "required_output": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "human_gate": { "type": ["string", "null"] },
    "last_action": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "files_changed": { "type": "array", "items": { "type": "string" } },
    "commits": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "test_results": { "type": "array", "items": { "type": "string" } },
    "deployment_state": {
      "type": "string",
      "enum": ["DESIGNED", "AUTHORED", "CONFIGURED", "TESTED_LOCALLY", "TESTED_INTEGRATION", "STAGED", "DEPLOYED", "LIVE_VERIFIED", "FAILED", "BLOCKED", "UNKNOWN"]
    },
    "rollback": { "type": "string" },
    "lease_owner": { "type": "string" },
    "lease_expiration": { "type": "string" },
    "status": { "type": "string", "enum": ["OPEN", "CLAIMED", "COMPLETED", "REJECTED"] }
  }
}
