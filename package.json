{
  "name": "nte-web-apps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:deal-architect": "npm run dev --workspace=apps/deal-architect",
    "dev:capital-readiness": "npm run dev --workspace=apps/capital-readiness",
    "dev:notes-underwriting": "npm run dev --workspace=apps/notes-underwriting",
    "dev:legacy-estate": "npm run dev --workspace=apps/legacy-estate",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --noEmit apps/deal-architect apps/capital-readiness apps/notes-underwriting apps/legacy-estate server packages/neterverse-kernel",
    "test": "npm test --workspace=packages/neterverse-kernel && npm test --workspace=server",
    "test:kernel": "npm test --workspace=packages/neterverse-kernel",
    "test:server": "npm test --workspace=server",
    "check:query-token": "node scripts/check-query-token.mjs",
    "bus": "node packages/neterverse-kernel/src/cli.ts"
  }
}
